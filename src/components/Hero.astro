---
import { siteConfig, portfolioProfiles, type ProfileKind } from "../config";
import Icon from "./Icon.astro";
interface Props {
  profile: ProfileKind;
}
const { profile } = Astro.props;
const content = portfolioProfiles[profile];
---

<div class="portfolio-hero text-center mb-12">
  <div class="hero-identity flex flex-col md:flex-row items-center justify-center gap-8 mb-6">
    <div class="shrink-0">
      <img
        src={siteConfig.image}
        width="256"
        height="256"
        alt={siteConfig.name}
        class="profile-portrait w-64 h-64 rounded-full object-cover border-4 border-gray-200 dark:border-gray-700 shadow-lg"
        fetchpriority="high"
      />
    </div>
    <div class="text-center md:text-left">
      <h1 class="hero-name text-4xl md:text-6xl font-bold text-gray-900 dark:text-white mb-4">
        {siteConfig.name}
      </h1>
      <p class="hero-subtitle text-xl text-gray-600 dark:text-gray-300">
        {content.subtitle}
      </p>
      <p class="text-base text-gray-500 dark:text-gray-400 mt-2">
        {siteConfig.location}
      </p>
    </div>
  </div>
  <div class="hero-contacts flex flex-wrap justify-center items-center gap-x-8 gap-y-4 text-base text-gray-600 dark:text-gray-400">
    <a
      href={`mailto:${siteConfig.social.email}`}
      class="contact-link flex items-center gap-3 hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
    >
      <Icon name="email" />
      {siteConfig.social.email}
    </a>
    <a
      href={siteConfig.social.linkedin}
      target="_blank"
      rel="noopener noreferrer"
      class="contact-link flex items-center gap-3 hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
    >
      <Icon name="linkedin" />
      LinkedIn
    </a>
    <a
      href={siteConfig.social.github}
      target="_blank"
      rel="noopener noreferrer"
      class="contact-link flex items-center gap-3 hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
    >
      <Icon name="github" />
      GitHub
    </a>
    <a
      href={content.resume}
      download
      class="contact-link flex items-center gap-3 hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
    >
      <Icon name="download" />
      {content.resumeLabel}
    </a>
  </div>
  {profile === "engineering" && (
    <h2 class="hero-introduction max-w-3xl mx-auto mt-6 text-left text-sm font-semibold text-primary-600 dark:text-primary-400">
      About me
    </h2>
  )}
  {"researchInterests" in content ? (
    <div class="hero-introduction max-w-3xl mx-auto mt-6 text-left text-base text-gray-600 dark:text-gray-300 leading-relaxed">
      <h2 class="font-semibold mb-2">Research interests</h2>
      <ul
        aria-label="Research interests"
        class="list-disc pl-5 text-left space-y-1"
      >
        {content.researchInterests.map((interest) => (
          <li>{interest}</li>
        ))}
      </ul>
    </div>
  ) : (
    <p class="hero-summary max-w-3xl mx-auto mt-3 text-left text-base text-gray-600 dark:text-gray-300 leading-relaxed">
      {content.summary}
    </p>
  )}
</div>
