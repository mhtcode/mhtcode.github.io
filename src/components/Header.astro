---
import Icon from "./Icon.astro";
import type { ProfileKind } from "../config";
interface Props {
  activeProfile?: ProfileKind;
}
const { activeProfile } = Astro.props;
const hasSectionMenu =
  Astro.url.pathname === "/" ||
  Astro.url.pathname.replace(/\/$/, "") === "/academic";
const currentProfile =
  activeProfile ??
  (Astro.url.pathname.startsWith("/research/") ||
  Astro.url.pathname.startsWith("/teaching-assistant/")
    ? "academic"
    : "engineering");
const portfolioTitle =
  currentProfile === "academic"
    ? "Academic Portfolio"
    : "Engineering Portfolio";
---

<header
  id="site-header"
  class="site-header bg-white dark:bg-gray-800 shadow-sm border-b border-gray-200 dark:border-gray-700"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="site-header-layout">
      {activeProfile && hasSectionMenu && (
        <button
          type="button"
          id="section-menu-toggle"
          class="section-menu-trigger"
          aria-label="Open sections menu"
          aria-haspopup="dialog"
          aria-expanded="false"
          aria-controls="section-drawer"
          aria-describedby="current-section-name"
          hidden
        >
          <svg
            viewBox="0 0 24 24"
            width="22"
            height="22"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <span id="current-section-name" class="sr-only"></span>
        </button>
      )}
      <a
        href={currentProfile === "academic" ? "/academic/" : "/"}
        class="header-brand text-2xl font-bold text-primary-600 dark:text-primary-400"
      >
        {portfolioTitle}
      </a>
      <div class="header-navigation">
        <nav
          aria-label="Portfolio views"
          class="profile-navigation text-sm font-medium"
        >
          <a
            href="/"
            aria-current={activeProfile === "engineering" ? "page" : undefined}
            class:list={[
              "view-link",
              { "view-link-active": activeProfile === "engineering" },
            ]}
          >
            Engineering
          </a>
          <a
            href="/academic/"
            aria-current={activeProfile === "academic" ? "page" : undefined}
            class:list={[
              "view-link",
              { "view-link-active": activeProfile === "academic" },
            ]}
          >
            Academic
          </a>
        </nav>
      </div>
      <button
        id="theme-toggle"
        type="button"
        aria-label="Switch to dark theme"
        aria-pressed="false"
        class="header-theme-toggle"
      >
        <Icon name="sun" class="w-5 h-5 hidden dark:block" />
        <Icon name="moon" class="w-5 h-5 dark:hidden" />
      </button>
    </div>
  </div>
</header>
<script>
  const header = document.querySelector<HTMLElement>("#site-header");
  if (header) {
    const updateHeaderHeight = () =>
      document.documentElement.style.setProperty(
        "--site-header-height",
        `${Math.ceil(header.getBoundingClientRect().height)}px`,
      );
    updateHeaderHeight();
    new ResizeObserver(updateHeaderHeight).observe(header);

    const menu = header.querySelector<HTMLButtonElement>(
      "#section-menu-toggle",
    );
    const navigation = header.querySelector<HTMLElement>(".header-navigation");
    const themeControl =
      header.querySelector<HTMLButtonElement>("#theme-toggle");
    if (menu && navigation && themeControl) {
      const mobile = window.matchMedia("(max-width: 767px)");
      const reducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      );
      let compact = false;
      let anchorTimer = 0;
      let frame = 0;

      function setCompact(next: boolean) {
        if (next === compact) return;
        compact = next;
        // Prevent the animated height change from moving the page's scroll anchor.
        document.documentElement.classList.add("header-transitioning");
        window.clearTimeout(anchorTimer);
        anchorTimer = window.setTimeout(
          () =>
            document.documentElement.classList.remove("header-transitioning"),
          reducedMotion.matches ? 100 : 320,
        );
        header!.classList.toggle("site-header-compact", compact);
        const focused = document.activeElement;
        if (
          compact &&
          focused?.matches(":focus-visible") &&
          (navigation!.contains(focused) || focused === themeControl)
        ) {
          menu!.focus({ preventScroll: true });
        }
        navigation!.inert = compact;
        themeControl!.inert = compact;
      }

      function updateScroll() {
        frame = 0;
        setCompact(mobile.matches && window.scrollY > 1);
      }

      window.addEventListener(
        "scroll",
        () => {
          if (!frame) frame = requestAnimationFrame(updateScroll);
        },
        { passive: true },
      );
      mobile.addEventListener("change", updateScroll);
      window.addEventListener("pageshow", updateScroll);
      updateScroll();
    }
  }
  const toggle = document.getElementById("theme-toggle");
  function updateThemeLabel() {
    const dark = document.documentElement.classList.contains("dark");
    toggle?.setAttribute(
      "aria-label",
      `Switch to ${dark ? "light" : "dark"} theme`,
    );
    toggle?.setAttribute("aria-pressed", String(dark));
  }
  updateThemeLabel();
  toggle?.addEventListener("click", () => {
    document.documentElement.classList.toggle("dark");
    try {
      localStorage.setItem(
        "theme",
        document.documentElement.classList.contains("dark") ? "dark" : "light",
      );
    } catch {}
    updateThemeLabel();
  });
</script>
