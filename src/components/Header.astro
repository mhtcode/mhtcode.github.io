---
import Icon from "./Icon.astro";
import type { ProfileKind } from "../config";
interface Props {
  activeProfile?: ProfileKind;
}
const { activeProfile } = Astro.props;
---

<header class="bg-white dark:bg-gray-800 shadow-sm border-b border-gray-200 dark:border-gray-700">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-wrap justify-between items-center gap-3 min-h-16 py-3">
      <a
        href="/"
        class="text-2xl font-bold text-primary-600 dark:text-primary-400"
      >
        Portfolio
      </a>
      <div class="flex items-center gap-3 sm:gap-6">
        <nav
          aria-label="Portfolio views"
          class="flex gap-3 sm:gap-6 text-sm font-medium"
        >
          <a
            href="/"
            aria-current={activeProfile === "engineering" ? "page" : undefined}
            class:list={[
              "view-link",
              { "view-link-active": activeProfile === "engineering" },
            ]}
          >
            Engineering
          </a>
          <a
            href="/academic/"
            aria-current={activeProfile === "academic" ? "page" : undefined}
            class:list={[
              "view-link",
              { "view-link-active": activeProfile === "academic" },
            ]}
          >
            Academic
          </a>
        </nav>
        <button
          id="theme-toggle"
          type="button"
          aria-label="Switch to dark theme"
          aria-pressed="false"
          class="p-2 rounded-lg bg-gray-100 dark:bg-gray-700 hover:bg-gray-200 dark:hover:bg-gray-600 transition-colors"
        >
          <Icon name="sun" class="w-5 h-5 hidden dark:block" />
          <Icon name="moon" class="w-5 h-5 dark:hidden" />
        </button>
      </div>
    </div>
  </div>
</header>
<script>
  const toggle = document.getElementById("theme-toggle");
  function updateThemeLabel() {
    const dark = document.documentElement.classList.contains("dark");
    toggle?.setAttribute(
      "aria-label",
      `Switch to ${dark ? "light" : "dark"} theme`,
    );
    toggle?.setAttribute("aria-pressed", String(dark));
  }
  updateThemeLabel();
  toggle?.addEventListener("click", () => {
    document.documentElement.classList.toggle("dark");
    try {
      localStorage.setItem(
        "theme",
        document.documentElement.classList.contains("dark") ? "dark" : "light",
      );
    } catch {}
    updateThemeLabel();
  });
</script>
