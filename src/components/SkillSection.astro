---
import type { ComponentProps } from "astro/types";
import type { ProfileKind } from "../config";
import type { ResumeItem } from "../portfolio";
import Icon from "./Icon.astro";
import ViewDetails from "./ViewDetails.astro";
import PortfolioTag from "./PortfolioTag.astro";
import { skillScores } from "../skill-scores";

interface Props {
  items: ResumeItem[];
  profile: ProfileKind;
}

const { items, profile } = Astro.props;
const skillsPath = profile === "academic" ? "/academic/skills/" : "/skills/";
const categoryIcons: Record<string, ComponentProps<typeof Icon>["name"]> = {
  "cloud-and-delivery": "cloud",
  mlops: "chip",
  observability: "activity",
  networking: "network",
  "programming-and-databases": "code",
  "data-and-analytics": "database",
  "ai-research": "flask",
  "product-and-projects": "clipboard",
  "teaching-and-communication": "users",
};
---

<div class="skill-grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
  {items.map((item) => (
    <article class="portfolio-card flex min-w-0 flex-col p-5 sm:p-6">
      <header class="mb-4 flex items-center gap-3">
        <span class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-blue-50 text-primary-700 dark:bg-primary-900/50 dark:text-primary-400">
          <Icon name={categoryIcons[item.slug] ?? "code"} class="size-5" />
        </span>
        <h3 class="text-base leading-snug font-semibold text-gray-900 dark:text-white">
          {item.title}
        </h3>
      </header>
      <ul
        class="skill-list space-y-2.5 text-sm text-gray-700 dark:text-gray-300"
        role="list"
      >
        {item.description.split(" · ").map((skill) => (
          <li>
            <div class="mb-1 flex items-baseline justify-between gap-2">
              <span>{skill}</span>
              <span class="shrink-0 text-xs tabular-nums" aria-hidden="true">
                {skillScores[skill]}%
              </span>
            </div>
            <div
              class="h-1.5 overflow-hidden rounded-full bg-gray-200 dark:bg-gray-700"
              role="meter"
              aria-label={skill}
              aria-valuemin="0"
              aria-valuemax="100"
              aria-valuenow={skillScores[skill]}
            >
              <span
                class="block h-full rounded-full bg-primary-600 dark:bg-primary-400"
                style={`width: ${skillScores[skill]}%`}
              ></span>
            </div>
          </li>
        ))}
      </ul>
      <div class="mt-auto flex flex-wrap items-center justify-between gap-x-3 pt-3">
        <PortfolioTag item={item} category="skills" />
        <a
          href={`${skillsPath}${item.slug}/`}
          class="resume-card group inline-flex min-h-11 items-center rounded-sm"
          aria-label={`View Details for ${item.title}`}
        >
          <ViewDetails />
        </a>
      </div>
    </article>
  ))}
</div>
<style>
  .skill-grid {
    display: grid;
  }
</style>
