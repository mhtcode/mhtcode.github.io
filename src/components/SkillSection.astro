---
import type { ComponentProps } from "astro/types";
import type { ProfileKind } from "../config";
import type { ResumeItem } from "../portfolio";
import Icon from "./Icon.astro";
import ViewDetails from "./ViewDetails.astro";

interface Props {
  items: ResumeItem[];
  profile: ProfileKind;
}

const { items, profile } = Astro.props;
const academic = profile === "academic";
const skillsPath = academic ? "/academic/skills/" : "/skills/";
type CategoryStyle = {
  icon: ComponentProps<typeof Icon>["name"];
  accent: string;
};
const categoryStyles: Record<string, CategoryStyle> = {
  "cloud-and-delivery": { icon: "cloud", accent: "#2563eb" },
  mlops: { icon: "chip", accent: "#047857" },
  observability: { icon: "activity", accent: "#9333ea" },
  networking: { icon: "network", accent: "#c2410c" },
  "programming-and-databases": { icon: "code", accent: "#be123c" },
  "data-and-analytics": { icon: "database", accent: "#4f46e5" },
  "ai-research": { icon: "flask", accent: "#0e7490" },
  "product-and-projects": { icon: "clipboard", accent: "#a16207" },
  "teaching-and-communication": { icon: "users", accent: "#be185d" },
};
---

<div class="mx-auto max-w-5xl">
  <header class="mb-8 text-center sm:mb-10">
    <h2 class="skill-title bg-linear-to-r from-violet-800 to-fuchsia-700 bg-clip-text text-3xl font-bold tracking-tight text-transparent sm:text-4xl dark:from-violet-300 dark:to-fuchsia-300">
      Technical Skills
    </h2>
    <p class="mt-2 text-gray-600 dark:text-gray-300">
      {academic
        ? "Cloud computing, applied AI, and research"
        : "Cloud, DevOps, and MLOps engineering"}
    </p>
  </header>

  <div class="skill-grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {items.map((item) => {
      const { icon, accent } =
        categoryStyles[item.slug] ?? categoryStyles["cloud-and-delivery"];
      return (
        <article
          class="flex min-w-0 flex-col rounded-xl border border-gray-200 bg-gray-100 p-5 dark:border-gray-700 dark:bg-gray-800"
          style={`--skill-accent: ${accent}`}
        >
          <header class="mb-4 flex items-center gap-3">
            <span class="skill-icon grid size-10 shrink-0 place-items-center rounded-lg text-white">
              <Icon name={icon} class="size-5" />
            </span>
            <h3 class="text-base leading-snug font-semibold text-gray-900 dark:text-white">
              {item.title}
            </h3>
          </header>
          <ul
            class="skill-list space-y-2.5 text-sm text-gray-700 dark:text-gray-200"
            role="list"
          >
            {item.description.split(" · ").map((skill) => (
              <li class="skill-row">{skill}</li>
            ))}
          </ul>
          <div class="mt-auto flex justify-end pt-3">
            <a
              href={`${skillsPath}${item.slug}/`}
              class="resume-card group inline-flex min-h-11 items-center rounded-sm"
              aria-label={`View Details for ${item.title}`}
            >
              <ViewDetails />
            </a>
          </div>
        </article>
      );
    })}
  </div>

  <aside class="mt-8 rounded-xl bg-linear-to-r from-sky-100 to-fuchsia-100 px-5 py-6 text-center sm:mt-10 dark:from-sky-950 dark:to-fuchsia-950">
    <h3 class="text-lg font-semibold text-gray-900 dark:text-white">
      Continuous Learning
    </h3>
    <p class="mx-auto mt-1.5 max-w-prose text-sm leading-relaxed text-gray-700 dark:text-gray-200">
      {academic
        ? "I build on my research in sustainable cloud computing through applied AI projects and hands-on experiments with model serving."
        : "I keep building these skills through my home lab and personal projects, from automating deployments to instrumenting services and serving AI models."}
    </p>
  </aside>
</div>

<style>
  .skill-grid {
    display: grid;
  }

  .skill-icon {
    background: var(--skill-accent);
  }

  .skill-row::after {
    display: block;
    height: 0.1875rem;
    margin-top: 0.375rem;
    border-radius: 999px;
    background: linear-gradient(
      to right,
      var(--skill-accent),
      color-mix(in srgb, var(--skill-accent) 16%, transparent)
    );
    content: "";
  }

  @media print, (forced-colors: active) {
    .skill-title {
      background: none;
      color: inherit;
    }
  }
</style>
