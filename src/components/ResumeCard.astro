---
import type { ResumeItem } from "../portfolio";
import ViewDetails from "./ViewDetails.astro";
import PortfolioTag from "./PortfolioTag.astro";
interface Props {
  item: ResumeItem;
  category: string;
  basePath?: string;
}
const { item, category, basePath = "/" } = Astro.props;
---

<article class="portfolio-card overflow-hidden">
  <a
    href={`${basePath}${category}/${item.slug}/`}
    class="resume-card group block"
  >
    <div class="md:flex">
      {item.image && (
        <div class="md:shrink-0">
          <div class="h-48 w-full md:w-48 bg-gray-200 dark:bg-gray-700 rounded-t-lg md:rounded-l-lg md:rounded-t-none overflow-hidden">
            <img
              src={item.image}
              alt={item.organization || item.title}
              width="192"
              height="192"
              class="w-full h-full object-contain"
              loading="lazy"
            />
          </div>
        </div>
      )}
      <div class="p-6 flex-1 min-w-0">
        <div class="card-heading flex flex-col sm:flex-row items-start justify-between gap-2 sm:gap-4">
          <div class="flex-1 min-w-0">
            <div class="mb-2 flex flex-wrap items-center gap-x-3 gap-y-1">
              <h3 class="text-xl font-semibold text-gray-900 dark:text-white">
                {item.title}
              </h3>
              <PortfolioTag item={item} category={category} />
            </div>
            {item.organization && (
              <p class="text-sm font-medium text-primary-600 dark:text-primary-400 mb-2">
                {item.organization}
              </p>
            )}
          </div>
          {(item.start || item.end) && (
            <div class="card-dates order-first sm:order-last text-sm text-gray-500 dark:text-gray-400 sm:text-right shrink-0">
              <span>{item.start}</span>
              {item.end && (
                <>
                  <span class="sr-only"> to </span>
                  <span class="sm:hidden" aria-hidden="true">
                    –
                  </span>
                  <span>{item.end}</span>
                </>
              )}
            </div>
          )}
        </div>
        <p class="card-description text-gray-700 dark:text-gray-300 mb-4">
          {item.description}
        </p>
        <div class="flex items-center justify-end">
          <ViewDetails />
        </div>
      </div>
    </div>
  </a>
</article>
