---
import Hero from "./Hero.astro";
import ResumeCard from "./ResumeCard.astro";
import { resumeSections } from "../portfolio";
import { portfolioProfiles, type ProfileKind } from "../config";
interface Props {
  profile: ProfileKind;
}
const { profile } = Astro.props;
const content = portfolioProfiles[profile];
function orderBySlug<T extends { slug: string }>(
  items: T[],
  order: string[],
): T[] {
  const rank = (slug: string) => {
    const index = order.indexOf(slug);
    return index === -1 ? order.length : index;
  };
  return [...items].sort((a, b) => rank(a.slug) - rank(b.slug));
}
const sections = orderBySlug(resumeSections, content.sectionOrder).map(
  (section) => {
    const order =
      section.slug === "skills"
        ? content.skillOrder
        : section.slug === "projects"
          ? content.projectOrder
          : section.slug === "experience"
            ? content.experienceOrder
            : [];
    return { ...section, items: orderBySlug(section.items, order) };
  },
);
---

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <Hero profile={profile} />
  <div
    role="tablist"
    aria-label={`${content.label} sections`}
    data-default-section={sections[0].slug}
    class="flex flex-wrap justify-center mb-8 border-b border-gray-200 dark:border-gray-700"
  >
    {sections.map((section, index) => (
      <button
        type="button"
        role="tab"
        id={`tab-button-${section.slug}`}
        class="tab-button px-6 py-3 text-sm font-medium text-gray-500 dark:text-gray-400 border-transparent hover:text-gray-700 dark:hover:text-gray-200 border-b-2 hover:border-gray-300 dark:hover:border-gray-600 transition-colors"
        data-tab={section.slug}
        data-active={index === 0 ? "true" : "false"}
        aria-controls={`tab-${section.slug}`}
        aria-selected={index === 0 ? "true" : "false"}
        tabindex={index === 0 ? 0 : -1}
      >
        {section.name}
      </button>
    ))}
  </div>
  {sections.map((section, index) => (
    <section
      role="tabpanel"
      class="tab-content"
      id={`tab-${section.slug}`}
      aria-labelledby={`tab-button-${section.slug}`}
      hidden={index !== 0}
      tabindex="0"
    >
      <div class="mb-8">
        <h2 class="text-3xl font-bold text-gray-900 dark:text-white mb-4">
          {section.name}
        </h2>
      </div>
      <div class="space-y-6">
        {section.items.map((item) => (
          <ResumeCard item={item} category={section.slug} />
        ))}
      </div>
    </section>
  ))}
  <noscript>
    <style>
      @layer base {
        .tab-content[hidden] {
          display: block !important;
          margin-top: 2rem;
        }
      }
      [role="tablist"] {
        display: none;
      }
    </style>
  </noscript>
</div>
<script>
  const buttons = Array.from(
    document.querySelectorAll<HTMLButtonElement>('[role="tab"]'),
  );
  const panels = Array.from(
    document.querySelectorAll<HTMLElement>('[role="tabpanel"]'),
  );
  function selectTab(slug: string, focus = false) {
    const selected =
      buttons.find((button) => button.dataset.tab === slug) || buttons[0];
    if (!selected) return;
    buttons.forEach((button) => {
      const active = button === selected;
      button.dataset.active = String(active);
      button.setAttribute("aria-selected", String(active));
      button.tabIndex = active ? 0 : -1;
    });
    panels.forEach((panel) => {
      panel.hidden = panel.id !== selected.getAttribute("aria-controls");
    });
    if (focus) selected.focus();
  }
  buttons.forEach((button, index) => {
    button.addEventListener("click", () => {
      selectTab(button.dataset.tab!);
      if (location.hash !== `#${button.dataset.tab}`)
        history.pushState(null, "", `#${button.dataset.tab}`);
    });
    button.addEventListener("keydown", (event) => {
      let next = index;
      if (event.key === "ArrowRight") next = (index + 1) % buttons.length;
      else if (event.key === "ArrowLeft")
        next = (index - 1 + buttons.length) % buttons.length;
      else if (event.key === "Home") next = 0;
      else if (event.key === "End") next = buttons.length - 1;
      else return;
      event.preventDefault();
      const slug = buttons[next].dataset.tab!;
      selectTab(slug, true);
      history.pushState(null, "", `#${slug}`);
    });
  });
  const readHash = () =>
    selectTab(
      location.hash.slice(1) ||
        document.querySelector<HTMLElement>("[data-default-section]")?.dataset
          .defaultSection ||
        "experience",
    );
  window.addEventListener("hashchange", readHash);
  window.addEventListener("popstate", readHash);
  readHash();
</script>
