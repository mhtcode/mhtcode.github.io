---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { siteConfig, type ProfileKind } from "../config";
import "../styles/global.css";
interface Props {
  title?: string;
  description?: string;
  activeProfile?: ProfileKind;
}
const {
  title = `${siteConfig.name} — ${siteConfig.title}`,
  description = siteConfig.description,
  activeProfile,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, siteConfig.url).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={siteConfig.name} />
    <meta name="theme-color" content="#f9fafb" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta
      property="og:image"
      content={new URL(siteConfig.image, siteConfig.url).href}
    />
    <meta name="twitter:card" content="summary" />
    <script is:inline>
      try {
        document.documentElement.classList.toggle(
          "dark",
          localStorage.getItem("theme") === "dark",
        );
      } catch {}
    </script>
  </head>
  <body class="bg-gray-50 dark:bg-gray-900 text-gray-900 dark:text-gray-100 transition-colors duration-300">
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <Header activeProfile={activeProfile} />
    <main id="main" class="min-h-screen">
      <slot />
    </main>
    <Footer />
  </body>
</html>
