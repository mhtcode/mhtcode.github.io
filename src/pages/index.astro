---
import Layout from "../layouts/Layout.astro";
import PortfolioOverview from "../components/PortfolioOverview.astro";
import { siteConfig, portfolioProfiles } from "../config";
const profile = portfolioProfiles.engineering;
---

<Layout
  title={`${siteConfig.name} — ${profile.title}`}
  description={profile.description}
  activeProfile="engineering"
>
  <PortfolioOverview profile="engineering" />
</Layout>
