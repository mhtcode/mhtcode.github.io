---
import PortfolioDetail from "../../components/PortfolioDetail.astro";
import { resumeSections } from "../../portfolio";
import { getProfileSections } from "../../profiles";
export function getStaticPaths() {
  const sections = getProfileSections("engineering");
  return resumeSections.flatMap((section) =>
    section.items.map((item) => ({
      params: { category: section.slug, slug: item.slug },
      props: {
        section: {
          ...section,
          name:
            sections.find((entry) => entry.slug === section.slug)?.name ||
            section.name,
        },
        item,
      },
    })),
  );
}
const { section, item } = Astro.props;
---

<PortfolioDetail section={section} item={item} profile="engineering" />
